--- a/RSSReaderApp/Views/ContentView.swift
+++ b/RSSReaderApp/Views/ContentView.swift
@@ -3682,7 +3682,8 @@ struct ContentView: View {
                 .textCase(nil)
                 .tracking(0.6)
         }
-        .padding(.top, showsDivider ? 10 : 22)
+        // The list now starts below the sidebar button, so the first header needs no extra clearance.
+        .padding(.top, showsDivider ? 10 : 0)
         .padding(.bottom, 2)
     }
 
