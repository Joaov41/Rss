-            .padding(.horizontal, 20)
+            .padding(.horizontal, summaryCardTextInset)
             .padding(.top, 12)
             
             Group {
@@ -4056,7 +4066,7 @@ VStack(alignment: .leading, spacing: 14) {
             }
             .padding(.top, 8)
             .padding(.bottom, 16)
