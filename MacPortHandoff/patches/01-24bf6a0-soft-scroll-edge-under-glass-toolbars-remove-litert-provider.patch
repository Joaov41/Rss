+                        ],
+                        startPoint: .top,
+                        endPoint: .bottom
+                    )
+                    .frame(height: height)
+                    Color.black
+                }
+                .ignoresSafeArea(edges: .bottom)
+            }
+        } else {
+            content
+        }
+    }
+}
